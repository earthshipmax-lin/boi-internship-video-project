[
  {
    "text": "一個家族嘅未來",
    "start": 2.4,
    "end": 3.9
  },
  {
    "text": "值得我哋睇得更遠",
    "start": 4.32,
    "end": 5.9
  },
  {
    "text": "源自一九九七年",
    "start": 6.12,
    "end": 7.78
  },
  {
    "text": "我哋一路走來，靠嘅係專業",
    "start": 8.12,
    "end": 10.78
  },
  {
    "text": "更加係每一份交到手上嘅信任",
    "start": 11.18,
    "end": 13.88
  },
  {
    "text": "集團總保費超過一百億港元",
    "start": 14.46,
    "end": 17.34
  },
  {
    "text": "總佣金超過十五億港元",
    "start": 17.64,
    "end": 20.14
  },
  {
    "text": "服務超過兩萬位高淨值客戶",
    "start": 20.42,
    "end": 23.2
  },
  {
    "text": "每一個數字背後",
    "start": 23.62,
    "end": 25.06
  },
  {
    "text": "都有一個家庭，對未來嘅期望",
    "start": 25.2,
    "end": 27.96
  },
  {
    "text": "所以，我哋一直向前",
    "start": 30.94,
    "end": 32.54
  },
  {
    "text": "連繫香港、深圳、紐約",
    "start": 33.2,
    "end": 35.16
  },
  {
    "text": "新加坡亦正籌備中",
    "start": 35.6,
    "end": 37.72
  },
  {
    "text": "從保險、信託，到稅務",
    "start": 38.18,
    "end": 40.52
  },
  {
    "text": "教育同身份規劃",
    "start": 40.8,
    "end": 42.54
  },
  {
    "text": "將專業連成一個平台",
    "start": 43.1,
    "end": 44.9
  },
  {
    "text": "為每一個家族",
    "start": 45.48,
    "end": 46.48
  },
  {
    "text": "睇得更全面，行得更長遠",
    "start": 46.72,
    "end": 49.16
  },
  {
    "text": "眼光，可以跨越地域",
    "start": 49.84,
    "end": 51.68
  },
  {
    "text": "信任，需要時間扎根",
    "start": 52.12,
    "end": 54.56
  },
  {
    "text": "根扎得深，先可以長得更高",
    "start": 55.1,
    "end": 57.46
  },
  {
    "text": "步伐夠穩，先可以走得更遠",
    "start": 57.8,
    "end": 60.36
  },
  {
    "text": "大展宏圖，穩如泰山",
    "start": 60.6,
    "end": 63.67
  },
  {
    "text": "宏泰國際",
    "start": 64.35,
    "end": 66.19
  }
]
