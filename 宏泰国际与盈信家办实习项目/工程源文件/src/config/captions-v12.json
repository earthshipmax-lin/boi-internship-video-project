[
  {
    "text": "一個家族嘅未來",
    "start": 2.4,
    "end": 3.9
  },
  {
    "text": "值得我哋睇得更遠",
    "start": 4.32,
    "end": 5.9
  },
  {
    "text": "源自一九九七年",
    "start": 6.12,
    "end": 7.78
  },
  {
    "text": "我哋一路走來，靠嘅係專業",
    "start": 8.12,
    "end": 10.78
  },
  {
    "text": "更加係每一份交到手上嘅信任",
    "start": 11.18,
    "end": 13.88
  },
  {
    "text": "集團總保費超過一百億港元",
    "start": 14.46,
    "end": 17.34
  },
  {
    "text": "總佣金超過十五億港元",
    "start": 17.64,
    "end": 20.14
  },
  {
    "text": "服務超過兩萬位高淨值客戶",
    "start": 20.42,
    "end": 23.2
  },
  {
    "text": "每一個數字背後",
    "start": 23.62,
    "end": 25.06
  },
  {
    "text": "都有一個家庭，對未來嘅期望",
    "start": 25.2,
    "end": 27.96
  },
  {
    "text": "所以，我哋一直向前",
    "start": 28.84,
    "end": 30.44
  },
  {
    "text": "連繫香港、深圳、紐約",
    "start": 31.1,
    "end": 33.06
  },
  {
    "text": "新加坡亦正籌備中",
    "start": 33.5,
    "end": 35.62
  },
  {
    "text": "從保險、信託，到稅務",
    "start": 36.08,
    "end": 38.42
  },
  {
    "text": "教育同身份規劃",
    "start": 38.7,
    "end": 40.44
  },
  {
    "text": "將專業連成一個平台",
    "start": 41.0,
    "end": 42.8
  },
  {
    "text": "為每一個家族",
    "start": 43.38,
    "end": 44.38
  },
  {
    "text": "睇得更全面，行得更長遠",
    "start": 44.62,
    "end": 47.06
  },
  {
    "text": "眼光，可以跨越地域",
    "start": 47.74,
    "end": 49.58
  },
  {
    "text": "信任，需要時間扎根",
    "start": 50.02,
    "end": 52.46
  },
  {
    "text": "根扎得深，先可以長得更高",
    "start": 53.0,
    "end": 55.36
  },
  {
    "text": "步伐夠穩，先可以走得更遠",
    "start": 55.7,
    "end": 58.26
  },
  {
    "text": "大展宏圖，穩如泰山",
    "start": 58.5,
    "end": 61.57
  },
  {
    "text": "宏泰國際",
    "start": 62.25,
    "end": 64.09
  }
]
